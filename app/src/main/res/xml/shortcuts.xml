<?xml version="1.0" encoding="utf-8"?>
<!-- Hold Swift's icon on the home screen (2.3). MainActivity.handleIntent acts on these. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_tab"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_tab"
        android:shortcutShortLabel="@string/shortcut_new_tab">
        <intent
            android:action="com.swiftbrowser.action.NEW_TAB"
            android:targetClass="com.swiftbrowser.ui.MainActivity"
            android:targetPackage="com.swiftbrowser.app" />
    </shortcut>
    <shortcut
        android:shortcutId="incognito"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_incognito"
        android:shortcutShortLabel="@string/shortcut_incognito">
        <intent
            android:action="com.swiftbrowser.action.INCOGNITO"
            android:targetClass="com.swiftbrowser.ui.MainActivity"
            android:targetPackage="com.swiftbrowser.app" />
    </shortcut>
    <shortcut
        android:shortcutId="scan"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutShortLabel="@string/shortcut_scan">
        <intent
            android:action="com.swiftbrowser.action.SCAN"
            android:targetClass="com.swiftbrowser.ui.MainActivity"
            android:targetPackage="com.swiftbrowser.app" />
    </shortcut>
</shortcuts>
