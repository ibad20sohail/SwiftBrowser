{
  "manifest_version": 2,
  "name": "Swift Helper",
  "version": "1.6.0",
  "description": "Video detection, playback speed, tap tracking, reader view and lighter styles for slow sites, for the Swift browser.",
  "browser_specific_settings": {
    "gecko": { "id": "helper@swiftbrowser.app" }
  },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["perf/youtube.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "include_globs": ["*://theflixer.*", "*://*.theflixer.*"],
      "css": ["perf/theflixer.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "webNavigation",
    "tabs",
    "<all_urls>"
  ]
}
