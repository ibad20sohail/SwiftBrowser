<?xml version="1.0" encoding="utf-8"?>
<!-- History, bookmarks and downloads (2.0): the title bar, an optional search box, and the list,
     which stays at a readable width on a turned phone; an empty list shows what goes there. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- 2.8: a little lower (was 60dp), with a smaller title (ListActivity). 3.0.5: one title bar on
         every screen (Settings' too); its colour is the page's (ListActivity). -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/list_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar"
        android:background="@color/page_bg" />

    <com.swiftbrowser.ui.MaxWidthLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 3.0.5: its look is Ui.searchBox's, the one search box of every screen. -->
        <EditText
            android:id="@+id/list_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_box"
            android:layout_marginStart="@dimen/side_margin"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/side_margin"
            android:layout_marginBottom="8dp"
            android:hint="Search"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:visibility="gone" />
    </com.swiftbrowser.ui.MaxWidthLayout>

    <com.swiftbrowser.ui.MaxWidthLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <FrameLayout
            android:id="@+id/list_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </com.swiftbrowser.ui.MaxWidthLayout>
</LinearLayout>
