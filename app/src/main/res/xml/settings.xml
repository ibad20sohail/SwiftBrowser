<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:iconSpaceReserved="false" app:title="Appearance">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="dark_mode"
            app:summary="Sites that support dark mode open dark too"
            app:title="Dark mode" />
    </PreferenceCategory>

    <PreferenceCategory app:iconSpaceReserved="false" app:title="Ad blocking">
        <ListPreference
            app:defaultValue="high"
            app:entries="@array/ad_levels"
            app:entryValues="@array/ad_level_keys"
            app:iconSpaceReserved="false"
            app:key="ad_level"
            app:title="Blocking level for all sites"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="site_levels"
            app:title="Sites with their own level" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="ubo_settings"
            app:summary="Filter lists, your own filters, advanced options"
            app:title="uBlock Origin settings" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="update_lists"
            app:summary="Lists also update by themselves every few days"
            app:title="Update filter lists now" />
    </PreferenceCategory>

    <PreferenceCategory app:iconSpaceReserved="false" app:title="Video">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="auto_landscape"
            app:summary="Full-screen videos turn to landscape automatically"
            app:title="Rotate full-screen videos" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="video_gestures"
            app:summary="In full screen, swipe up/down on the left for brightness, on the right for volume"
            app:title="Swipe gestures" />
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="hls_to_mp4"
            app:summary="Convert downloaded video streams to MP4 when possible (otherwise they are saved as .ts)"
            app:title="Save streams as MP4" />
    </PreferenceCategory>

    <PreferenceCategory app:iconSpaceReserved="false" app:title="Downloads">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="confirm_downloads"
            app:summary="Protects against sites that start downloads by themselves"
            app:title="Ask before downloading files" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="download_folder"
            app:title="Download folder" />
    </PreferenceCategory>

    <PreferenceCategory app:iconSpaceReserved="false" app:title="Memory">
        <ListPreference
            app:defaultValue="3"
            app:entries="@array/live_tabs"
            app:entryValues="@array/live_tabs"
            app:iconSpaceReserved="false"
            app:key="max_live_tabs"
            app:title="Tabs kept loaded"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:iconSpaceReserved="false" app:title="Privacy">
        <Preference
            app:iconSpaceReserved="false"
            app:key="clear_data"
            app:summary="History, cookies, cached files of the current profile"
            app:title="Clear browsing data" />
    </PreferenceCategory>

    <PreferenceCategory app:iconSpaceReserved="false" app:title="About">
        <Preference
            app:iconSpaceReserved="false"
            app:key="about"
            app:title="Swift" />
    </PreferenceCategory>
</PreferenceScreen>
