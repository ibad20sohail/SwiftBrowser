<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 9 Swift can't put its font in the system's place (AppFont), so "sans-serif" would
         be the phone's font here: these ask for Swift's own by name. Below 9 they are in res/values. -->
    <style name="Swift.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/swift_sans</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Swift.ActionMenuText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">@font/swift_sans_medium</item>
    </style>

    <style name="Swift.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">@font/swift_sans</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Swift.ListTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="lineHeight">24sp</item>
        <item name="android:fontFamily">@font/swift_sans</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
