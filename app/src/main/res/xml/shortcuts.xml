<?xml version="1.0" encoding="utf-8"?>
<!-- Hold Swift's icon on the home screen (2.3). MainActivity.handleIntent acts on these. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_tab"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_tab"
        android:shortcutShortLabel="@string/shortcut_new_tab">
        <intent
            android:action="com.swiftbrowser.action.NEW_TAB"
            android:targetClass="com.swiftbrowser.ui.MainActivity"
            android:targetPackage="com.swiftbrowser.app" />
    </shortcut>
    <shortcut
        android:shortcutId="incognito"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_incognito"
        android:shortcutShortLabel="@string/shortcut_incognito">
        <intent
            android:action="com.swiftbrowser.action.INCOGNITO"
            android:targetClass="com.swiftbrowser.ui.MainActivity"
            android:targetPackage="com.swiftbrowser.app" />
    </shortcut>
    <!-- 2.7: Files and Documents (Scan QR is on the widget and in the menu). Android 7 shows about
         5 shortcuts: these 4 and the last document read (Docs.updateShortcuts). -->
    <shortcut
        android:shortcutId="files"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_files"
        android:shortcutShortLabel="@string/shortcut_files">
        <intent
            android:action="com.swiftbrowser.action.FILES"
            android:targetClass="com.swiftbrowser.ui.MainActivity"
            android:targetPackage="com.swiftbrowser.app" />
    </shortcut>
    <shortcut
        android:shortcutId="documents"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_documents"
        android:shortcutShortLabel="@string/shortcut_documents">
        <intent
            android:action="com.swiftbrowser.action.DOCUMENTS"
            android:targetClass="com.swiftbrowser.ui.MainActivity"
            android:targetPackage="com.swiftbrowser.app" />
    </shortcut>
</shortcuts>
