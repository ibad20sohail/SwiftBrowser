<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/switcher_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:id="@+id/switcher_new"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:text="New tab"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/switcher_toggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_toggle"
                android:orientation="horizontal"
                android:padding="3dp">

                <FrameLayout
                    android:id="@+id/toggle_normal"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_toggle_item"
                    android:contentDescription="Tabs">

                    <TextView
                        android:id="@+id/toggle_normal_count"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tab_count"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/toggle_incognito"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_toggle_item"
                    android:contentDescription="Incognito tabs">

                    <ImageView
                        android:id="@+id/toggle_incognito_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_incognito"
                        app:tint="@color/text_primary" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/switcher_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="24dp" />

            <LinearLayout
                android:id="@+id/switcher_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_incognito"
                    app:tint="@color/incognito_hint" />

                <TextView
                    android:id="@+id/switcher_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No incognito tabs"
                    android:textColor="@color/incognito_text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/switcher_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Incognito tabs keep no history, and their cookies are deleted when you close them."
                    android:textColor="@color/incognito_hint"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switcher_empty_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="New incognito tab" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</merge>
