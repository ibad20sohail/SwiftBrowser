<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The grid of all tabs: new tab, search, and the tabs / incognito toggle. -->
        <LinearLayout
            android:id="@+id/switcher_header"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/switcher_new"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_button"
                android:drawablePadding="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="New tab"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="15sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/switcher_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search your tabs"
                android:src="@drawable/ic_search"
                app:tint="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/switcher_toggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_toggle"
                android:orientation="horizontal"
                android:padding="3dp">

                <FrameLayout
                    android:id="@+id/toggle_normal"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_toggle_item"
                    android:contentDescription="Tabs">

                    <TextView
                        android:id="@+id/toggle_normal_count"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_tab_count"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/toggle_incognito"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_toggle_item"
                    android:contentDescription="Incognito tabs">

                    <ImageView
                        android:id="@+id/toggle_incognito_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_incognito"
                        app:tint="@color/text_primary" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Inside a group, the inactive tabs or a search: back, a title or search box, actions. -->
        <LinearLayout
            android:id="@+id/switcher_subheader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/sub_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <View
                android:id="@+id/sub_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sub_title"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/sub_search"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_url"
                android:hint="Search your tabs"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/sub_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="New tab in this group"
                android:src="@drawable/ic_add"
                android:visibility="gone"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/sub_more"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Group options"
                android:src="@drawable/ic_more"
                android:visibility="gone"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/sub_action"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/switcher_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="24dp" />

            <LinearLayout
                android:id="@+id/switcher_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/switcher_empty_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_incognito"
                    app:tint="@color/incognito_hint" />

                <TextView
                    android:id="@+id/switcher_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="No incognito tabs"
                    android:textColor="@color/incognito_text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/switcher_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Incognito tabs keep no history, and their cookies are deleted when you close them."
                    android:textColor="@color/incognito_hint"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/switcher_empty_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="New incognito tab" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</merge>
