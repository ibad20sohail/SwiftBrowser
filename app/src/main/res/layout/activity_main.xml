<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The page fills this area; the toolbar floats on top and slides away while scrolling. -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.swiftbrowser.ui.GestureFrameLayout
                android:id="@+id/gesture_layer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.swiftbrowser.ui.SwiftGeckoView
                    android:id="@+id/gecko"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.swiftbrowser.ui.GestureFrameLayout>

            <com.swiftbrowser.ui.HomeView
                android:id="@+id/home"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/toolbar_height"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/crash_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/toolbar_height"
                android:background="@color/page_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="This tab crashed"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crash_reload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Reload" />
            </LinearLayout>

            <!-- Fades out over the page when a new tab opens. -->
            <View
                android:id="@+id/page_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/toolbar_height"
                android:background="@color/page_bg"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/suggestions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/toolbar_height"
                android:background="@color/toolbar_bg"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ptr_indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ptr"
                android:elevation="4dp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_refresh"
                android:visibility="gone"
                app:tint="@color/accent" />

            <TextView
                android:id="@+id/hud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_hud"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/speed_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hud"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/app_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toolbar_height"
                android:layout_gravity="top">

                <LinearLayout
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/toolbar_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="2dp">

                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:id="@+id/profile_chip"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:gravity="center"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/incognito_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="Incognito"
                            android:src="@drawable/ic_incognito"
                            android:visibility="gone"
                            app:tint="@color/incognito_text" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/url_box"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_url"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="2dp">

                        <ImageView
                            android:id="@+id/url_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_google_g" />

                        <EditText
                            android:id="@+id/url_edit"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/url_hint"
                            android:imeOptions="actionGo|flagNoExtractUi"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:selectAllOnFocus="true"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_secondary"
                            android:textSize="15sp" />

                        <ImageButton
                            android:id="@+id/url_mic"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Search by voice"
                            android:src="@drawable/ic_mic"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/url_clear"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Clear"
                            android:src="@drawable/ic_close"
                            android:visibility="gone" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/video_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Videos on this page"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_download"
                            app:tint="@color/accent" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/shield_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Ad blocking">

                        <ImageView
                            android:id="@+id/shield_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shield" />

                        <TextView
                            android:id="@+id/shield_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="16dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/bg_badge"
                            android:gravity="center"
                            android:minWidth="16dp"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:textColor="#FFFFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/tabs_btn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Tabs">

                        <TextView
                            android:id="@+id/tabs_count"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_tab_count"
                            android:gravity="center"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <ImageButton
                        android:id="@+id/menu_btn"
                        style="@style/Swift.ToolbarButton"
                        android:contentDescription="Menu"
                        android:src="@drawable/ic_more" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:max="100"
                    android:progressTint="@color/accent"
                    android:visibility="invisible" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/find_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/toolbar_bg"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/find_edit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/find_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/find_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/find_prev"
                style="@style/Swift.ToolbarButton"
                android:contentDescription="Previous"
                android:src="@drawable/ic_up" />

            <ImageButton
                android:id="@+id/find_next"
                style="@style/Swift.ToolbarButton"
                android:contentDescription="Next"
                android:src="@drawable/ic_down" />

            <ImageButton
                android:id="@+id/find_close"
                style="@style/Swift.ToolbarButton"
                android:contentDescription="Close"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </LinearLayout>

    <com.swiftbrowser.ui.TabSwitcherView
        android:id="@+id/tab_switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp"
        android:visibility="gone" />
</FrameLayout>
