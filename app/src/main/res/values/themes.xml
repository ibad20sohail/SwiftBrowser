<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every Material component (dialogs, switches, buttons, sheets, snackbars) takes its colours
         from Swift's palette, light or dark (values-night). -->
    <style name="Base.Theme.Swift" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorSurface">@color/sheet_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/sheet_bg</item>
        <item name="colorSurfaceContainerLow">@color/sheet_bg</item>
        <item name="colorSurfaceContainer">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHigh">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHighest">@color/surface_alt</item>
        <!-- No automatic tinting of raised surfaces (dialogs, sheets): Swift's colours as they are. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Swift.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Swift.Dialog</item>
        <item name="android:windowAnimationStyle">@style/Swift.WindowAnimations</item>
        <!-- Text buttons in title bars ("Clear all") as written, not in capitals. -->
        <item name="actionMenuTextAppearance">@style/Swift.ActionMenuText</item>
        <item name="android:actionMenuTextAppearance">@style/Swift.ActionMenuText</item>
    </style>

    <style name="Swift.ActionMenuText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Quicker than Android 7's own screen transitions; the screen underneath doesn't move. -->
    <style name="Swift.WindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/swift_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/swift_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/swift_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/swift_close_exit</item>
    </style>

    <style name="Theme.Swift" parent="Base.Theme.Swift">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The browser screen's theme while the app starts: the logo instead of an empty window. -->
    <style name="Theme.Swift.Launch">
        <item name="android:windowBackground">@drawable/bg_launch</item>
    </style>

    <style name="Theme.Swift.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Swift.BottomSheetStyle</item>
    </style>

    <style name="Swift.BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/sheet_bg</item>
        <item name="shapeAppearance">@style/Swift.SheetShape</item>
    </style>

    <style name="Swift.SheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Dialogs: Swift's surface colour and slightly tighter corners than Material's default. -->
    <style name="ThemeOverlay.Swift.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Swift.DialogShape</item>
        <item name="colorSurface">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHigh">@color/sheet_bg</item>
        <!-- 2.0: the same title and text in every dialog. Choices (radio and tick lists) are
             normal text, not the grey of secondary text. -->
        <item name="colorOnSurfaceVariant">@color/text_primary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="alertDialogStyle">@style/Swift.AlertDialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Swift.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Swift.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Swift.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Swift.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Swift.DialogButton</item>
    </style>

    <!-- 2.1: plain lists (setItems) in normal text too. -->
    <style name="Swift.AlertDialog" parent="MaterialAlertDialog.Material3">
        <item name="listItemLayout">@layout/dialog_list_item</item>
    </style>

    <style name="Swift.DialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="Swift.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Swift.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Swift.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- 48 dp high to tap (2.6); 40 wide, so the address keeps its room. -->
    <style name="Swift.ToolbarButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- Accent colour overlays (1.9): applied by every screen before it draws (Looks.apply).
         Material parts (switches, buttons, chips, dialog buttons, text cursors) follow them. -->
    <style name="ThemeOverlay.Swift.Accent.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/on_accent_blue</item>
        <item name="colorPrimaryContainer">@color/accent_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_blue_container</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/on_accent_blue</item>
        <item name="colorSecondaryContainer">@color/accent_blue_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_blue_container</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="colorControlActivated">@color/accent_blue</item>
        <item name="android:colorAccent">@color/accent_blue</item>
    </style>
    <style name="ThemeOverlay.Swift.Accent.Green" parent="">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorOnPrimary">@color/on_accent_green</item>
        <item name="colorPrimaryContainer">@color/accent_green_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_green_container</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@color/on_accent_green</item>
        <item name="colorSecondaryContainer">@color/accent_green_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_green_container</item>
        <item name="colorAccent">@color/accent_green</item>
        <item name="colorControlActivated">@color/accent_green</item>
        <item name="android:colorAccent">@color/accent_green</item>
    </style>
    <style name="ThemeOverlay.Swift.Accent.Purple" parent="">
        <item name="colorPrimary">@color/accent_purple</item>
        <item name="colorOnPrimary">@color/on_accent_purple</item>
        <item name="colorPrimaryContainer">@color/accent_purple_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_purple_container</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/on_accent_purple</item>
        <item name="colorSecondaryContainer">@color/accent_purple_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_purple_container</item>
        <item name="colorAccent">@color/accent_purple</item>
        <item name="colorControlActivated">@color/accent_purple</item>
        <item name="android:colorAccent">@color/accent_purple</item>
    </style>
    <style name="ThemeOverlay.Swift.Accent.Orange" parent="">
        <item name="colorPrimary">@color/accent_orange</item>
        <item name="colorOnPrimary">@color/on_accent_orange</item>
        <item name="colorPrimaryContainer">@color/accent_orange_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_orange_container</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">@color/on_accent_orange</item>
        <item name="colorSecondaryContainer">@color/accent_orange_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_orange_container</item>
        <item name="colorAccent">@color/accent_orange</item>
        <item name="colorControlActivated">@color/accent_orange</item>
        <item name="android:colorAccent">@color/accent_orange</item>
    </style>
    <style name="ThemeOverlay.Swift.Accent.Red" parent="">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorOnPrimary">@color/on_accent_red</item>
        <item name="colorPrimaryContainer">@color/accent_red_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_red_container</item>
        <item name="colorSecondary">@color/accent_red</item>
        <item name="colorOnSecondary">@color/on_accent_red</item>
        <item name="colorSecondaryContainer">@color/accent_red_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_red_container</item>
        <item name="colorAccent">@color/accent_red</item>
        <item name="colorControlActivated">@color/accent_red</item>
        <item name="android:colorAccent">@color/accent_red</item>
    </style>
    <style name="ThemeOverlay.Swift.Accent.Teal" parent="">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorOnPrimary">@color/on_accent_teal</item>
        <item name="colorPrimaryContainer">@color/accent_teal_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_teal_container</item>
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/on_accent_teal</item>
        <item name="colorSecondaryContainer">@color/accent_teal_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_teal_container</item>
        <item name="colorAccent">@color/accent_teal</item>
        <item name="colorControlActivated">@color/accent_teal</item>
        <item name="android:colorAccent">@color/accent_teal</item>
    </style>
</resources>
