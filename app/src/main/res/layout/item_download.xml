<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:minHeight="@dimen/row_two_lines"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <!-- 3.0.5: the one row icon holder, a rounded square (Ui.ICON_BOX, Ui.R_SMALL). -->
    <ImageView
        android:id="@+id/dl_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_icon_badge"
        android:importantForAccessibility="no"
        android:padding="9dp"
        app:tint="@color/text_secondary" />

    <!-- While a bar shows, DownloadsActivity moves the status from dl_text to the end of dl_body: the
         full width, under the two buttons. A finished row keeps it beside them. -->
    <LinearLayout
        android:id="@+id/dl_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/dl_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dl_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_subtitle" />

                <ProgressBar
                    android:id="@+id/dl_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:indeterminateTint="?attr/colorPrimary"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_rounded" />

                <TextView
                    android:id="@+id/dl_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="swift-small"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="2"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/dl_action"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Pause or resume"
                app:tint="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/dl_more"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"
                android:src="@drawable/ic_more"
                app:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
