<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 2.4: the Documents screen lists the phone's PDFs, Office files and e-books (asked the first time). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 2.7: the Files screen on Android 11 and later ("Allow access to manage all files"). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Installing a downloaded update of Swift (Settings → Check for updates). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 2.2: scanning QR codes (asked the first time). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- "Add to home screen" on Android 7 launchers. -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!-- Voice search: find the phone's speech recogniser (normally the Google app); read aloud: its voices. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SwiftApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Swift">

        <activity
            android:name=".ui.MainActivity"
            android:theme="@style/Theme.Swift.Launch"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Hold the app icon: New tab, Incognito tab, Scan QR code (2.3). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Lets Swift be chosen to open web links from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.HistoryActivity" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
        <activity android:name=".ui.BookmarksActivity" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- 2.8: a document on a screen of its own, over whatever opened it. No task affinity: from
             another app it joins that app's task (Back returns there), or a task of its own. -->
        <activity
            android:name=".ui.DocumentActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateHidden">
            <!-- 2.4: "Open with Swift" for documents from other apps; since 2.8 straight to the viewer's screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.swiftbrowser.action.OPEN_DOC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 2.8: pictures opened from Files, on a screen of their own. 2.9: pictures only, and
             "Open with Swift" for pictures from other apps (no task affinity: Back returns there).
             Only the kinds Android 7 can show (not SVG or HEIC). -->
        <activity
            android:name=".ui.MediaViewerActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/bmp" />
            </intent-filter>
        </activity>
        <!-- 2.9: Swift's video and music player. A task of its own (singleTask), so the notification and
             "Open with Swift" always find the one player screen. Turning is handled by the screen itself
             (configChanges), so what plays doesn't restart; the orientation is set while playing. -->
        <activity
            android:name=".ui.PlayerActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.player"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- 2.9: music from the player (and a video's sound with "Play in background") going on with the screen off. -->
        <service
            android:name=".media.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 2.9: Files' "Free up space" and Wi-Fi transfer. -->
        <activity android:name=".ui.CleanerActivity" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
        <activity
            android:name=".ui.WifiTransferActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity android:name=".ui.DownloadsActivity" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- 2.7: Files, a file manager with archives (ZIP, 7z, RAR…). Its own task affinity: opened
             from its own icon it is an app of its own in recent apps, not stacked on the browser. -->
        <activity
            android:name=".ui.FilesActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.files"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- 2.7: Files as its own icon in the app list (Settings can hide it, with Documents). -->
        <activity-alias
            android:name="com.swiftbrowser.ui.FilesApp"
            android:exported="true"
            android:icon="@drawable/ic_launcher_files"
            android:label="@string/app_files"
            android:roundIcon="@drawable/ic_launcher_files"
            android:targetActivity=".ui.FilesActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 2.7: copying, moving, extracting and compressing files go on with the screen left. -->
        <service
            android:name=".files.FileJobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keep playing in the background: keeps a playing video or song going, with its controls. -->
        <service
            android:name=".media.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Read aloud (reader view) going on in the background, with pause and stop. -->
        <service
            android:name=".media.ReadAloudService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- The "Swift VPN" quick settings tile (2.3). -->
        <service
            android:name=".vpn.VpnTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_vpn"
            android:label="@string/tile_vpn"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <!-- The "New tab" quick settings tile (2.6). -->
        <service
            android:name=".ui.NewTabTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_new_tab"
            android:label="@string/tile_new_tab"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The home screen widget (2.6): search, incognito, scan a QR code. -->
        <receiver
            android:name=".ui.SearchWidget"
            android:exported="true"
            android:label="@string/widget_search">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_search" />
        </receiver>

        <!-- Notes engine crashes for the problem report; in its own process so it survives them. -->
        <service
            android:name=".engine.CrashReportService"
            android:exported="false"
            android:process=":crashreport" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 2.2: the QR scanner, turning with the phone and in full screen when Swift is. -->
        <activity
            android:name=".ui.QrScanActivity"
            android:exported="false"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />
    </application>
</manifest>
