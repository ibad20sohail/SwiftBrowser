{
  "manifest_version": 2,
  "name": "Swift Helper",
  "version": "1.2.0",
  "description": "Video detection, playback speed and tap tracking for the Swift browser.",
  "browser_specific_settings": {
    "gecko": { "id": "helper@swiftbrowser.app" }
  },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "webNavigation",
    "tabs",
    "<all_urls>"
  ]
}
