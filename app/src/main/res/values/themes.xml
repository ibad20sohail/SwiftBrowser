<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Every Material component (dialogs, switches, buttons, sheets, snackbars) takes its colours
         from Swift's palette, light or dark (values-night). -->
    <style name="Base.Theme.Swift" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/on_accent_container</item>
        <item name="colorSurface">@color/sheet_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/sheet_bg</item>
        <item name="colorSurfaceContainerLow">@color/sheet_bg</item>
        <item name="colorSurfaceContainer">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHigh">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHighest">@color/surface_alt</item>
        <!-- No automatic tinting of raised surfaces (dialogs, sheets): Swift's colours as they are. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:colorBackground">@color/page_bg</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/toolbar_bg</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Swift.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Swift.Dialog</item>
        <item name="android:windowAnimationStyle">@style/Swift.WindowAnimations</item>
    </style>

    <!-- Quicker than Android 7's own screen transitions; the screen underneath doesn't move. -->
    <style name="Swift.WindowAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/swift_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/swift_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/swift_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/swift_close_exit</item>
    </style>

    <style name="Theme.Swift" parent="Base.Theme.Swift">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The browser screen's theme while the app starts: the logo instead of an empty window. -->
    <style name="Theme.Swift.Launch">
        <item name="android:windowBackground">@drawable/bg_launch</item>
    </style>

    <style name="Theme.Swift.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Swift.BottomSheetStyle</item>
    </style>

    <style name="Swift.BottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/sheet_bg</item>
        <item name="shapeAppearance">@style/Swift.SheetShape</item>
    </style>

    <style name="Swift.SheetShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Dialogs: Swift's surface colour and slightly tighter corners than Material's default. -->
    <style name="ThemeOverlay.Swift.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/Swift.DialogShape</item>
        <item name="colorSurface">@color/sheet_bg</item>
        <item name="colorSurfaceContainerHigh">@color/sheet_bg</item>
    </style>

    <style name="Swift.DialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="Swift.ToolbarButton" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
